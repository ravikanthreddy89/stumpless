# ── Upstash Redis (required on Vercel) ────────────────────────────────────────
# Create a free database at https://console.upstash.com
# Go to your database → REST API → copy the values below
UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-token>

# ── Stable DID keypair (required on Vercel) ────────────────────────────────────
# Run the issuer once locally WITHOUT these set — it will print the values.
# Copy-paste them here and into Vercel Environment Variables.
ISSUER_DID=did:key:z...
ISSUER_PRIVATE_KEY_BASE64=<base64-encoded 32-byte Ed25519 private key>
ISSUER_PUBLIC_KEY_BASE64=<base64-encoded 32-byte Ed25519 public key>

# ── Service URL (set to your Vercel domain after first deploy) ─────────────────
ISSUER_URL=https://vc-issuer.vercel.app
