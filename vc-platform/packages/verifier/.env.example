# ── Upstash Redis (required on Vercel) ────────────────────────────────────────
# Can share the same Upstash DB as the issuer (keys are namespaced)
UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-token>

# ── Stable DID keypair (required on Vercel) ────────────────────────────────────
VERIFIER_DID=did:key:z...
VERIFIER_PRIVATE_KEY_BASE64=<base64-encoded 32-byte Ed25519 private key>
VERIFIER_PUBLIC_KEY_BASE64=<base64-encoded 32-byte Ed25519 public key>

# ── Service URL (set to your Vercel domain after first deploy) ─────────────────
VERIFIER_URL=https://vc-verifier.vercel.app
